      "panels": [
        {
          "sceneId": "scene-03a",
          "caption": "Мама поставила кашу на стол. Четыре миски, четыре ложки — а посередине тёплый хлеб.",
          "label": "04 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03a-v1.webp",
            "sha256": "037b2eb4099769a1e917edb32f2fca62c3f19bff0ecb6fb89cfe28cf69aa4d4f"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 32,
          "y": 154,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03b",
          "caption": "— Этот кусочек? — спросил Папа. Пин-Пин протянул обе лапки: — Этот!",
          "label": "05 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03b-v1.webp",
            "sha256": "1a5ab8a5a59c95ffe6b16a5b57aaa160edf906a6cdf62755bd2506071ae18443"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 744,
          "y": 154,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03c",
          "caption": "Пом-Пом постучал ложкой. Мама постучала своей в ответ. Тук-тук!",
          "label": "06 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03c-v1.webp",
            "sha256": "1e7f04fae9bc7e758688a1ea384f2d093df0651f9007b860adb22e5bcd4d3c88"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 1456,
          "y": 154,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03d",
          "caption": "Пин-Пин отнёс Маме пустую миску. — А теперь поиграем?",
          "label": "07 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03d-v1.webp",
            "sha256": "adbcf0f50204b5fd7ae1034eadfac2cffbd096965262de243bd2915ef123a0e1"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2168,
          "y": 154,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03e",
          "caption": "Мама покатила мягкий мячик по коврику. Пин-Пин прижал его к животику.",
          "label": "08 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03e-v1.webp",
            "sha256": "818431353af5941716698fc80885208c8ed033f1b9dfb61bbbb4d97da4e75ba6"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2880,
          "y": 154,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03f",
          "caption": "Мячик покатился обратно — прямо к Пом-Пому! Он обнял мячик, а Мама засмеялась.",
          "label": "09 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03f-v1.webp",
            "sha256": "fd5e1426986bdf9324497ca8ff178d3a80e063ea5dfeb0673d29ccba0a7587fd"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 32,
          "y": 794,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03g",
          "caption": "— Мы со Скуби немного погуляем, — сказал Папа. — Ему ещё надо потренироваться.",
          "label": "10 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03g-v1.webp",
            "sha256": "90cf531a30e133b1a87a0912f668d91b6bfeb6e399f7242fc64dbe60a0d942d1"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 744,
          "y": 794,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03h",
          "caption": "Снаружи Скуби опустил к Папе большой нос. Хвост уже ходил ходуном.",
          "label": "11 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03h-v1.webp",
            "sha256": "e394bec3bf4a7cbae83714906c5d8d286886cea3751eec6cfd572449b201d54e"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 1456,
          "y": 794,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03i",
          "caption": "— Сидеть, Скуби. — Он сел. И тут же снова навострил уши.",
          "label": "12 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03i-v1.webp",
            "sha256": "d4196a146376951d4b9555290458cbb7df30567185c99877014f34ac17198d41"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2168,
          "y": 794,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03j",
          "caption": "Тук-тук! Пин-Пин поднял голову от мячика.",
          "label": "13 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03j-v2.webp",
            "sha256": "784f47af0361902fbc8cc83d4880229dd3fd12c1c5f5a4364d94c8496da2ebfc"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2880,
          "y": 794,
          "width": 688,
          "height": 616
        },
        {
          "sceneId": "scene-03k",
          "caption": "Мама открыла дверь. На ступеньке ждала Зайка.",
          "label": "14 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03k-v1.webp",
            "sha256": "5e73e13aa43d426114906917a5051601423ce0bd6104cac05d1ca8d57ded1bf0"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 32,
          "y": 1434,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-03l",
          "caption": "— Пойдём играть, Пин-Пин! — Зайка нашла два листочка для корабликов.",
          "label": "15 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03l-v1.webp",
            "sha256": "b40ac36e16a2f183f826d340f8be4c2ad85c30fa0a3e660c0dd0958cdb5da81b"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 744,
          "y": 1434,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-03m",
          "caption": "— Конечно, — сказала Мама. — Только сначала принеси, пожалуйста, одно ведёрко воды для ванны.",
          "label": "16 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-03m-v1.webp",
            "sha256": "4bda9eb877f8a753d8d924154cb76dcba2ba942e1aa397cad6a91395b046e57f"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 1456,
          "y": 1434,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-04a1",
          "caption": "— Скуби сильный, — сказал Папа. — После тренировки он поможет нам нести вещи.",
          "label": "19 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-04a1-v1.webp",
            "sha256": "2265919ee66ea1ded0a94e8ada203b374d2c212f8a9dc562a279b9122ed29a3e"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2168,
          "y": 1434,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-04a2",
          "caption": "Нос Скуби повернулся в другую сторону. — Значит, нам сюда! — сказал Папа.",
          "label": "20 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-04a2-v1.webp",
            "sha256": "55fe669d63e5016ceef76fb690adabc564004170258dc9e190e116c18d6bb64c"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 2880,
          "y": 1434,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-05g1",
          "caption": "— Пригни голову, Скуби. — Сначала появился нос. Потом уши. А потом — очень много собаки.",
          "label": "32 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-05g1-v2.webp",
            "sha256": "4e1a9296b26c9cf4b203f7e4880d1b36f0c5e8996bd5de56623881ec3b457c80"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 32,
          "y": 2114,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-05g2",
          "caption": "Скуби сел. Свободного пола на кухне сразу стало совсем мало! Папа положил в его миску несколько ягод голубики.",
          "label": "33 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-05g2-v1.webp",
            "sha256": "8855094286a8af60bd1a779545e046057eaf978b8fe6252f716545400bf84a92"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 744,
          "y": 2114,
          "width": 688,
          "height": 656
        },
        {
          "sceneId": "scene-05g3",
          "caption": "— А теперь — на солнышко. — Папа вывел Скуби на крылечко. Пин-Пин осторожно прошёл мимо с ведёрком.",
          "label": "34 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/opening/web/scene-05g3-v2.webp",
            "sha256": "abad08da381f69cefa8709b6e7730d2015060943bb428c45f676cdd98048783d"
          },
          "readingBeat": {},
          "readingBeatLabel": "",
          "x": 1456,
          "y": 2114,
          "width": 688,
          "height": 656
        }
      ]
