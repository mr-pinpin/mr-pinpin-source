      "panels": [
        {
          "sceneId": "scene-32b1",
          "caption": "Тук-тук-тук. Пин-Пин прислушался. — Там что-то строят!",
          "label": "70 · New",
          "input": {
            "path": "/Volumes/TB4/mac-mini-storage/shared/pinpin-bath-magic-20261002-r17/art/beaver-return/web/scene-32b1-v1.webp",
