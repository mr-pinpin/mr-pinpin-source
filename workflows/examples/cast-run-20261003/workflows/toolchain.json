      "sha256",
      "reviewStatus",
      "workflowCard",
      "timing",
      "dossierPath"
    ],
    "dossierPath": "reports/character-packages/<entity>.json"
  },
  "help": "Register unreviewed candidate and optional dossier in one call; no selection or approval.",
  "castOperations": {
    "toolPath": "tools/cast_ops.py",
    "finish": "python -B tools/cast_ops.py finish <entity>",
    "checkpoint": "python -B tools/cast_ops.py checkpoint <batch> <entity> ...",
    "authority": "Durable draft metadata; visual QA required, no approval or publication"
  },
  "imageGeneration": {
    "tool": "image_gen.imagegen",
    "maxInputReferences": 5,
    "rolePriority": [
      "PRIMARY",
      "identity",
      "counterpart",
      "layout",
      "style",
      "context"
    ],
    "preparationInvocation": "tools.cast_ops.rank_reference_pack(references)",
