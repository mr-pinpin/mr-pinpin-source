{
  "schemaVersion": 1,
  "toolName": "studio-register-image",
  "argvPrefix": [
    "/Volumes/TB4/mac-mini-storage/shared/pinpin-studio-venv/bin/python",
    "/Volumes/TB4/mac-mini-storage/shared/pinpin-r17-studio-source/tools/studio-client/register-image.py",
    "--runtime-dir",
    "/Volumes/TB4/mac-mini-storage/shared/pinpin-studio-runtime"
  ],
  "helperSha256": "13499e857ccebcbb9956e1d01e3d91b63af6e1882c968ea6ab91804164e4a03f",
  "parameters": {
    "required": [
      "--native-path",
      "--prompt-file",
      "--output-name"
    ],
