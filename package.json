{
  "name": "mr-pinpin-source",
  "private": true,
  "scripts": {
    "assets:plan": "node tools/assets/catalog.cjs",
    "assets:sync": "node tools/assets/sync.cjs",
    "assets:push": "${PINPIN_PYTHON:-python3} tools/assets/hf_store.py push --manifest assets/manifest.json --root . --profile archive",
    "assets:pull": "${PINPIN_PYTHON:-python3} tools/assets/hf_store.py pull --manifest assets/manifest.json --root . --profile archive",
    "assets:restore-production": "${PINPIN_PYTHON:-python3} tools/assets/hf_store.py pull --manifest tools/assets/production-preservation.json --root . --profile archive",
    "assets:verify": "${PINPIN_PYTHON:-python3} tools/assets/hf_store.py verify --manifest assets/manifest.json --root . --profile archive",
    "build": "npm run build:pages",
    "build:pages": "node tools/assets/build-pages.cjs",
    "test": "node --test --test-concurrency=2 tools/assets/*.test.cjs scripts/*.test.cjs",
    "test:assets": "node --test tools/assets/*.test.cjs scripts/atlas-camera-return.test.cjs",
    "test:publishing": "python3 -B -m unittest discover -s tools/publishing -p 'test_*.py'",
    "release": "python3 tools/publishing/publish.py",
    "verify": "npm run test:assets && npm run build:pages -- --check"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "parse-srcset": "^1.0.2",
    "parse5": "^7.3.0",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0"
  }
}
