<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>io.mr-pinpin.firebase-recovery</string>
<key>ProgramArguments</key><array>
<string>/opt/homebrew/bin/node</string>
<string>__HOME__/.local/share/pinpin-connect/firebase/current/cli.mjs</string>
<string>forward</string>
<string>__HOME__/.config/pinpin-connect/firebase.json</string>
</array>
<key>EnvironmentVariables</key><dict>
<key>PINPIN_CLIENT_CURRENT</key><string>__HOME__/.local/share/pinpin-connect/firebase/current</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
<key>Umask</key><integer>63</integer>
<key>StandardOutPath</key><string>__HOME__/.config/pinpin-connect/firebase.log</string>
<key>StandardErrorPath</key><string>__HOME__/.config/pinpin-connect/firebase.log</string>
</dict></plist>
