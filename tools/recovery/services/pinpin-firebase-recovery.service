[Unit]
Description=PinPin independent Firebase SSH recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /root/.local/share/pinpin-connect/firebase/cli.mjs helper /root/.local/share/pinpin-access/firebase/helper.json
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
